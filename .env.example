# Neon (Vercel -> Storage -> Neon). La integración crea DATABASE_URL automáticamente.
DATABASE_URL=

# Cadena aleatoria larga (mínimo 32 caracteres) para firmar la sesión:  openssl rand -base64 48
SESSION_SECRET=

# Clave temporal (mínimo 12 caracteres) solo para configurar Google Authenticator la primera vez
SETUP_KEY=

